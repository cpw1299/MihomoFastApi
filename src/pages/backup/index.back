<!-- <template>
  <view class="backup-page">
    <view class="page-header">
      <text class="page-title">数据备份管理</text>
      <text class="page-subtitle">自动备份与恢复</text>
    </view>

    <!-- 备份状态卡片 -->
    <view class="status-card">
      <view class="status-item">
        <text class="status-label">自动备份</text>
        <text class="status-value" :class="{ active: autoBackupEnabled }">
          {{ autoBackupEnabled ? '已开启' : '已关闭' }}
        </text>
      </view>
      <view class="status-item">
        <text class="status-label">最近备份</text>
        <text class="status-value">{{ lastBackupTime || '暂无备份' }}</text>
      </view>
      <view class="status-item">
        <text class="status-label">本地备份数</text>
        <text class="status-value">{{ backupCount }}个</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button class="btn btn-primary" @click="handleManualBackup">
        <text class="btn-text">立即备份</text>
      </button>
      <button class="btn btn-secondary" @click="toggleAutoBackup">
        <text class="btn-text">{{ autoBackupEnabled ? '关闭自动备份' : '开启自动备份' }}</text>
      </button>
    </view>

    <!-- 备份列表 -->
    <view class="backup-list">
      <view class="list-header">
        <text class="list-title">备份历史</text>
        <text class="list-count">共{{ backups.length }}个</text>
      </view>
      
      <scroll-view class="backup-scroll" scroll-y>
        <view v-if="backups.length === 0" class="empty-state">
          <text class="empty-text">暂无备份记录</text>
        </view>
        
        <view v-else class="backup-items">
          <view 
            v-for="backup in backups" 
            :key="backup.fileName"
            class="backup-item"
            @click="showBackupOptions(backup)"
          >
            <view class="item-info">
              <text class="item-name">{{ formatBackupName(backup.fileName) }}</text>
              <text class="item-time">{{ formatTime(backup.generatedAt) }}</text>
            </view>
            <view class="item-status" :class="getStatusClass(backup.uploadStatus)">
              <text class="status-text">{{ getStatusText(backup.uploadStatus) }}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 备份选项弹窗 -->
    <uni-popup ref="backupOptionsPopup" type="bottom">
      <view class="popup-content">
        <view class="popup-header">
          <text class="popup-title">备份操作</text>
          <text class="popup-close" @click="closeBackupOptions">×</text>
        </view>
        
        <view class="popup-options">
          <view class="option-item" @click="restoreFromBackup">
            <text class="option-text">恢复数据</text>
          </view>
          <view class="option-item" @click="uploadBackup">
            <text class="option-text">立即上传</text>
          </view>
          <view class="option-item" @click="deleteBackup">
            <text class="option-text">删除备份</text>
          </view>
          <view class="option-item" @click="shareBackup">
            <text class="option-text">分享备份</text>
          </view>
        </view>
        
        <view class="popup-cancel">
          <text class="cancel-text" @click="closeBackupOptions">取消</text>
        </view>
      </view>
    </uni-popup>
  </view>
</template>

<script setup>
import { ref, computed, onMounted } from 'vue';
import { useAppStore } from '@/stores/app';
import { backupManager } from '@/utils/backup';

const store = useAppStore();
const backupOptionsPopup = ref(null);
const selectedBackup = ref(null);

// 计算属性
const backups = computed(() => store.backups);
const backupCount = computed(() => backups.value.length);
const autoBackupEnabled = computed(() => store.settings.autoUpload);

const lastBackupTime = computed(() => {
  if (backups.value.length === 0) return null;
  const latest = backups.value[0];
  return formatTime(latest.generatedAt);
});

// 生命周期
onMounted(() => {
  // 刷新备份列表
  refreshBackupList();
});

// 方法
function formatTime(timestamp) {
  const date = new Date(timestamp);
  const now = new Date();
  const diff = now - date;
  
  if (diff < 60000) return '刚刚';
  if (diff < 3600000) return `${Math.floor(diff / 60000)}分钟前`;
  if (diff < 86400000) return `${Math.floor(diff / 3600000)}小时前`;
  
  return date.toLocaleDateString('zh-CN');
}

function formatBackupName(fileName) {
  if (fileName.startsWith('manual_backup_')) {
    return '手动备份 ' + fileName.replace('manual_backup_', '').replace('.json', '');
  }
  if (fileName.startsWith('backup_')) {
    return '自动备份 ' + fileName.replace('backup_', '').replace('.json', '');
  }
  return fileName;
}

function getStatusClass(status) {
  return {
    'status-pending': status === 'pending',
    'status-success': status === 'success',
    'status-failed': status === 'failed',
  };
}

function getStatusText(status) {
  const statusMap = {
    pending: '待上传',
    success: '已上传',
    failed: '上传失败',
  };
  return statusMap[status] || '未知状态';
}

function refreshBackupList() {
  const backupList = backupManager.getBackupList();
  store.setBackups(backupList);
}

async function handleManualBackup() {
  try {
    uni.showLoading({ title: '创建备份中...' });
    const fileName = await backupManager.triggerManualBackup();
    uni.hideLoading();
    
    uni.showToast({
      title: '备份创建成功',
      icon: 'success',
    });
    
    refreshBackupList();
  } catch (error) {
    uni.hideLoading();
    uni.showToast({
      title: '备份创建失败',
      icon: 'error',
    });
    console.error('手动备份失败:', error);
  }
}

function toggleAutoBackup() {
  const newValue = !autoBackupEnabled.value;
  store.saveSettings({ autoUpload: newValue });
  
  uni.showToast({
    title: newValue ? '自动备份已开启' : '自动备份已关闭',
    icon: 'success',
  });
}

function showBackupOptions(backup) {
  selectedBackup.value = backup;
  backupOptionsPopup.value.open();
}

function closeBackupOptions() {
  backupOptionsPopup.value.close();
  selectedBackup.value = null;
}

async function restoreFromBackup() {
  if (!selectedBackup.value) return;
  
  closeBackupOptions();
  
  uni.showModal({
    title: '确认恢复',
    content: '恢复备份将覆盖当前所有数据，此操作不可撤销，是否继续？',
    success: async (res) => {
      if (res.confirm) {
        try {
          uni.showLoading({ title: '恢复数据中...' });
          
          const backupData = await backupManager.readBackupFile(selectedBackup.value.localPath);
          const result = store.importData(backupData);
          
          uni.hideLoading();
          
          if (result.ok) {
            uni.showToast({
              title: '数据恢复成功',
              icon: 'success',
            });
          } else {
            uni.showToast({
              title: result.message || '数据恢复失败',
              icon: 'error',
            });
          }
        } catch (error) {
          uni.hideLoading();
          uni.showToast({
            title: '数据恢复失败',
            icon: 'error',
          });
          console.error('数据恢复失败:', error);
        }
      }
    },
  });
}

function uploadBackup() {
  if (!selectedBackup.value) return;
  
  closeBackupOptions();
  
  // TODO: 实现立即上传逻辑
  uni.showToast({
    title: '上传功能开发中',
    icon: 'none',
  });
}

function deleteBackup() {
  if (!selectedBackup.value) return;
  
  closeBackupOptions();
  
  uni.showModal({
    title: '确认删除',
    content: '确定要删除这个备份吗？',
    success: (res) => {
      if (res.confirm) {
        // TODO: 实现删除逻辑
        uni.showToast({
          title: '删除功能开发中',
          icon: 'none',
        });
      }
    },
  });
}

function shareBackup() {
  if (!selectedBackup.value) return;
  
  closeBackupOptions();
  
  // TODO: 实现分享逻辑
  uni.showToast({
    title: '分享功能开发中',
    icon: 'none',
  });
}
</script>

